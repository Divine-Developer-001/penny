# ---- PayPal sandbox ----
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=AY0xDemoClientIDReplaceMe
PAYPAL_CLIENT_SECRET=DemoSecretReplaceMe
PAYPAL_WEBHOOK_ID=WEBHOOK_ID          # literal WEBHOOK_ID while using the simulator
PAYPAL_PAYOUT_RECEIVER_EMAIL=personal-facilitator@example.com
PAYPAL_NEGATIVE_TEST=false            # true -> inject ERRPYO002 in payout note
VITE_PAYPAL_CLIENT_ID=AY0xDemoSandboxClientID   # same sandbox client id; the frontend reads it from this file (public by design)

# ---- Broker (paper trading) ----
BROKER_MODE=alpaca                    # alpaca | simulated
ALPACA_API_KEY_ID=PKNVDemoKeyIDReplaceMe
ALPACA_SECRET_KEY=DemoSecretReplaceMe
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- LLM (OpenAI-compatible; defaults = Groq free tier) ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk-demo-key-replace-me
LLM_MODEL=llama-3.3-70b-versatile

# ---- Channel3 (optional; falls back to sample deals if unset) ----
CHANNEL3_API_KEY=

# ---- Penny rules ----
RISK_PROFILE=growth                   # conservative | balanced | growth
CASHBACK_RATE=0.02
FEE_ASSUMED_USD=0.50
MAX_FEE_DRAG_PCT=0.05
MIN_TRADE_USD=5.00
TRADE_CAP_USD=25.00                   # above -> needs user approval
HOLD_MAX_DAYS=30
UNDO_WINDOW_SECONDS=60
AGENT_INTERVAL_MINUTES=15
QUOTE_STALENESS_SECONDS=300
SEED_ON_START=true

# ---- App ----
DATABASE_URL=sqlite:///./penny.db     # postgres://... on Render
FRONTEND_ORIGIN=http://localhost:5173 # CORS in dev
PORT=8000
LOG_LEVEL=INFO
